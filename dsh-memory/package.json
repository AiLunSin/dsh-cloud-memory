{
  "name": "dsh-cloud-memory",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Persistent cross-session memory for DeepSeek Harness: hybrid semantic + keyword recall, RRF fusion, three-tier cache, and a Web management page.",
  "license": "MIT",
  "author": "dsh-cloud-memory contributors",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "memory",
    "embedding",
    "bge-m3",
    "hybrid-search",
    "rrf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AiLunSin/dsh-cloud-memory.git"
  },
  "homepage": "https://github.com/AiLunSin/dsh-cloud-memory#readme",
  "bugs": {
    "url": "https://github.com/AiLunSin/dsh-cloud-memory/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md",
    "examples/*.yml"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/http.mjs && node test/node-http.mjs && node test/edge.mjs && node test/cache.mjs && node test/redis.mjs && node test/chunk.mjs",
    "test:semantic": "node test/semantic.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
